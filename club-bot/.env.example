# ===== 必須設定 =====
# Botトークン（Discord Developer Portal で取得）
DISCORD_TOKEN=
# 対象サーバー（ギルド）ID（任意・後方互換用）
# 未指定でも動作します（マルチテナントモード: 参加中の全サーバーで独立動作）。
# 既存の単一サーバー運用では従来どおり指定してください
# （DB マイグレーション時のバックフィル値としても使われます）。
GUILD_ID=

# 暗号鍵（Todoist トークンの暗号化保存に必須）
# 生成方法:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ※ この鍵1本が参加している全サーバー（全テナント）の Todoist トークンを
#   保護します。紛失すると全サーバーで保存済みトークンを復号できなくなり、
#   各サーバーで /todoist-setup の再実行が必要になります。
#   バックアップ・ローテーション・漏洩時の手順は
#   docs/OPERATION.md 7章「暗号鍵（ENCRYPTION_KEY）の管理」を参照。
ENCRYPTION_KEY=

# ===== データベース =====
# ローカル開発・テスト用: SQLite のパス（デフォルト: ./data/club.db）
DB_PATH=./data/club.db
# 本番（PostgreSQL 構成）用: PostgreSQL 接続 URL。
# 設定すると PostgreSQL に接続し、DB_PATH の SQLite は使いません。
# DATABASE_URL=postgresql://clubbot:パスワード@127.0.0.1:5432/clubdb
# コネクションプールのサイズ（既定 1〜10）。ダッシュボードは別プロセスで
# 独立したプールを持つため、PostgreSQL の max_connections に対して
#   bot + ダッシュボード + LISTEN 用1本 が収まるように調整すること。
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=10

# ===== 共通 =====
# タイムゾーン（デフォルト: Asia/Tokyo）
TZ=Asia/Tokyo

# 注: Google Sheets の常時同期は廃止されました（NocoDB 移行）。
#     旧 Sheets からのデータ移行に必要な環境変数（SPREADSHEET_ID 等）は
#     scripts/migrate_sheets_to_db.py の実行時のみ設定します（docs/NOCODB.md 参照）。
# 注: Google Sheets 連携は撤去しました。CSV 出力は Web ダッシュボードと
#     /report export-tasks が担います。
#     GOOGLE_CREDENTIALS_PATH は、旧シートからの一回限りの移行スクリプトを
#     実行するときだけ設定します（併せて pip install gspread google-auth）。
# GOOGLE_CREDENTIALS_PATH=./credentials.json
# 注: Todoist の API トークンは .env には書きません。
#     セキュリティのため、Discord 上で各サーバーの管理者が
#     /todoist-setup を実行し、表示されるフォーム（Modal）から登録します
#     （暗号化して DB に保存）。
# 注: その他の設定（チャンネルID、ロールIDなど）もボットコマンドで設定できます
#     （/settings_set /set_channel /set_role など）。
# 注: 日程調整の出欠リアクション絵文字は、各サーバーの管理者が
#     /schedule emoji set で設定します（サーバーごとに保存・再起動不要）。
#     下記の環境変数は全サーバー共通のフォールバックとしてのみ機能します
#     （通常は設定不要。ID はカスタム絵文字の数値 ID）。
# SCHEDULE_EMOJI_OK_ID=
# SCHEDULE_EMOJI_MAYBE_ID=
# SCHEDULE_EMOJI_NG_ID=
