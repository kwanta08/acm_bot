# ===== ダッシュボード（別プロセス）の設定 =====
# bot 本体の .env とは別ファイル。Discord Bot トークンは不要。

# セッション Cookie の署名鍵（必須）
# 生成: python -c "import secrets; print(secrets.token_urlsafe(48))"
DASHBOARD_SECRET_KEY=

# Discord OAuth2（必須）
# Developer Portal > OAuth2 > Client information
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Portal の Redirects に同じ値を登録すること
DASHBOARD_REDIRECT_URI=https://example.com/auth/callback

# 公開 URL（ログイン後のリダイレクト先の組み立てに使用）
DASHBOARD_BASE_URL=https://example.com

# セッション有効期間（秒。既定 7 日）
# DASHBOARD_SESSION_MAX_AGE=604800

# ローカル開発で HTTP のまま動かす場合のみ 0 にする（本番では設定しない）
# DASHBOARD_SECURE_COOKIE=0

# ===== DB（bot と共有） =====
DB_PATH=./data/club.db
# DATABASE_URL=postgresql://clubbot:パスワード@127.0.0.1:5432/clubdb
