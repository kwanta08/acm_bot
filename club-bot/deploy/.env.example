# deploy/docker-compose.postgres.yml（推奨）および
# deploy/docker-compose.nocodb.yml（レガシー）用の環境変数。
# このファイルを deploy/.env にコピーして設定する。
# ※ deploy/.env は秘密情報を含むため絶対にコミットしないこと

# PostgreSQL（業務 DB。bot も同じ DB に接続する）
POSTGRES_USER=clubbot
POSTGRES_PASSWORD=   # 強固なパスワードを設定
POSTGRES_DB=clubdb

# ---------------------------------------------------------------------
# NocoDB（レガシー構成: docker-compose.nocodb.yml。PostgreSQL 単体構成では不要）
# ---------------------------------------------------------------------
# NocoDB の認証トークン署名鍵（openssl rand -hex 32 で生成）
NOCODB_JWT_SECRET=
