# deploy/docker-compose.directus.yml（推奨）および
# deploy/docker-compose.nocodb.yml（レガシー）用の環境変数。
# このファイルを deploy/.env にコピーして設定する。
# ※ deploy/.env は秘密情報を含むため絶対にコミットしないこと

# PostgreSQL（業務 DB。bot も同じ DB に接続する）
POSTGRES_USER=clubbot
POSTGRES_PASSWORD=   # 強固なパスワードを設定
POSTGRES_DB=clubdb

# ---------------------------------------------------------------------
# Directus（推奨構成: docker-compose.directus.yml）
# ---------------------------------------------------------------------
# 暗号化・セッション用の鍵（それぞれ openssl rand -hex 32 で生成し、
# KEY と SECRET には別々の値を設定する）
DIRECTUS_KEY=
DIRECTUS_SECRET=

# 初回起動時のみ作成される Directus 管理者アカウント（運用者用）
DIRECTUS_ADMIN_EMAIL=
DIRECTUS_ADMIN_PASSWORD=   # 強固なパスワードを設定

# 招待メールのリンクに使う公開 URL（SSH トンネル運用なら既定のままでよい）
DIRECTUS_PUBLIC_URL=http://localhost:8055

# 招待メールの送信設定（未設定でも起動するが招待メールは届かない。
# その場合は docs/DIRECTUS.md の手動フォールバック手順を使う）
EMAIL_FROM=no-reply@example.com
EMAIL_TRANSPORT=smtp
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_SECURE=false

# ---------------------------------------------------------------------
# NocoDB（レガシー構成: docker-compose.nocodb.yml。Directus 利用時は不要）
# ---------------------------------------------------------------------
# NocoDB の認証トークン署名鍵（openssl rand -hex 32 で生成）
NOCODB_JWT_SECRET=
