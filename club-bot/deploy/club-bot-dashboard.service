# /etc/systemd/system/club-bot-dashboard.service
# ダッシュボード（FastAPI）の常駐サービス定義。
#
# **bot とは別プロセス**として動かす。Web 層の不具合や再起動が
# Discord 接続へ波及しないようにするため（設計方針 2.2）。
#
# このファイル内のパス・ユーザー名は「作業用ユーザーを ubuntu、
# リポジトリのクローン先を /home/ubuntu/club-bot」とした場合の例です。
# その場合、コード本体は 1 階層下の /home/ubuntu/club-bot/club-bot、
# venv はさらにその下の .../club-bot/venv になります
# （.github/workflows/deploy.yml も同じ前提でデプロイします）。
# 手動で app/ 等に配置している場合は WorkingDirectory / ExecStart を実際の
# パスへ書き換えてください。
#
# 導入:
#   cd /home/ubuntu/club-bot/club-bot
#   venv/bin/pip install -r dashboard/requirements.txt
#   # ReadWritePaths のディレクトリは**事前に作る**。無いと systemd が
#   # 名前空間を作れず status=226/NAMESPACE で無限再起動になる。
#   mkdir -p /home/ubuntu/club-bot/logs /home/ubuntu/club-bot/data
#   sudo cp deploy/club-bot-dashboard.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now club-bot-dashboard
[Unit]
Description=Club Bot Dashboard (FastAPI)
After=network-online.target
Wants=network-online.target
# DB が Docker Compose の場合は docker.service の後に起動する
After=docker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/club-bot/club-bot
# 127.0.0.1 にのみバインドする（公開は Caddy 経由。直接公開しない）。
# --proxy-headers で Caddy の X-Forwarded-* を解釈する。
ExecStart=/home/ubuntu/club-bot/club-bot/venv/bin/uvicorn dashboard.main:app \
    --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=10
# ダッシュボード専用の設定（DASHBOARD_SECRET_KEY / DISCORD_CLIENT_ID /
# DISCORD_CLIENT_SECRET / DASHBOARD_REDIRECT_URI / DATABASE_URL）。
# bot の .env とは分ける（ダッシュボードに Bot トークンは不要）。
EnvironmentFile=/home/ubuntu/club-bot/dashboard.env
# アプリの INFO ログ（utils/logger.py の RotatingFileHandler）の書き込み先。
# WorkingDirectory 基準の相対 logs/ は ProtectHome=read-only で書けず、
# ディレクトリ作成に失敗 → Restart=always で再起動ループになる（D2-5）。
# 必ず ReadWritePaths 内の絶対パスを指す。アプリ本体のログは
# dashboard.log（ローテーションあり）に残る
Environment=LOG_DIR=/home/ubuntu/club-bot/logs
# プロセスの標準出力（uvicorn のアクセスログ等）。
# dashboard.log は RotatingFileHandler が掴むため、**同じファイルへ
# 向けない**（systemd の追記 fd とローテーションが競合する）
StandardOutput=append:/home/ubuntu/club-bot/logs/dashboard.out
StandardError=append:/home/ubuntu/club-bot/logs/dashboard.err

# --- 権限の最小化 ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# 下の 2 つのディレクトリは**サービス開始前に実在している必要がある**。
# 無いと "Failed to set up mount namespacing: ... No such file or directory"
# （status=226/NAMESPACE）で起動できず、Restart=always と相まって
# 10 秒ごとに再起動を繰り返す。
ReadWritePaths=/home/ubuntu/club-bot/logs /home/ubuntu/club-bot/data

[Install]
WantedBy=multi-user.target
